<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TOPPEUR</RootNamespace>
    <AssemblyName>TOPPEUR</AssemblyName>
    <Version>0.5.0</Version>
    <Description>窗口层级管理工具(MVP:快捷键置顶)</Description>
    <!-- 应用程序(exe)图标 -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- 每显示器 V2 DPI 感知,避免多显示器/缩放错位 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 仅保留简体中文卫星资源(MessageBox 按钮等),减小体积 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 自包含单文件发布:dotnet publish -c Release 即可 -->
    <!-- 注:WinForms 不支持裁剪(NETSDK1175),启用单文件压缩以控制体积 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标与 logo 嵌入程序集,单文件发布后无需外部文件 -->
    <EmbeddedResource Include="Assets\logo.ico" />
    <EmbeddedResource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
